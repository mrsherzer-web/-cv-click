# ---- חובה ----
# מפתח Claude API מ-https://console.anthropic.com (Settings → API keys). אל תשתפו אותו עם אף אחד.
ANTHROPIC_API_KEY=

# סיסמה לדף הניהול (admin.html). לפחות 16 תווים אקראיים.
ADMIN_TOKEN=

# ---- אחסון (חובה לפני השקה) ----
# מתחברים דרך Vercel → Storage → Upstash Redis, והמשתנים האלה נוספים לבד.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- מודל ומחיר ----
# ברירת מחדל: claude-opus-5-5. אפשר לנסות claude-sonnet-5-5 או claude-haiku-5-5 (זולים יותר).
CLAUDE_MODEL=claude-opus-5-5
# עומק החשיבה בסריקה: low / medium / high (ברירת מחדל high)
SCAN_EFFORT=high

# ---- מכסות ----
FREE_SCANS_PER_MONTH=5
FREE_RECIPES_PER_MONTH=10
PREMIUM_SCANS_PER_DAY=30
PREMIUM_RECIPES_PER_DAY=60
IP_SCANS_PER_DAY=15
GLOBAL_SCANS_PER_DAY=500
MAX_IMAGES=5

# ---- Premium ----
# מה שמוצג בכפתור השדרוג, למשל: ₪14.90 לחודש
PREMIUM_PRICE_TEXT=
# קישור לדף התשלום שלכם (Grow, PayPlus, Lemon Squeezy, Paddle...). {device} יוחלף במזהה המכשיר.
CHECKOUT_URL=
SUPPORT_EMAIL=
