{
  "name": "gefen-snooker",
  "productName": "הסנוקר של גפן",
  "version": "1.0.0",
  "description": "משחק אימה: שרדו חמישה לילות במועדון הסנוקר של גפן",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-packager . GefenSnooker --platform=win32 --arch=x64 --icon=icon.ico --out=out --overwrite --ignore=^/out --ignore=node_modules/.cache",
    "build:mac": "electron-packager . GefenSnooker --platform=darwin --arch=universal --icon=icon.png --out=out --overwrite --ignore=^/out",
    "build:linux": "electron-packager . GefenSnooker --platform=linux --arch=x64 --icon=icon.png --out=out --overwrite --ignore=^/out"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "38.2.0"
  }
}
